# Exemple — NE PAS COMMITER les vraies valeurs.
# Générer le vrai fichier 02-secrets.yaml via : ./scripts/gen-secrets.sh
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: todo-app
type: Opaque
stringData:
  POSTGRES_USER: "todoapp"
  POSTGRES_PASSWORD: "REPLACE_ME"
  DATABASE_URL: "postgres://todoapp:REPLACE_ME@postgres:5432/todos"
